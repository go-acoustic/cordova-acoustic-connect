{
  "name": "demo-capacitor-angular",
  "version": "1.0.0",
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "native:setup": "node scripts/prepare-native.mjs",
    "sync": "ng build && cap sync",
    "e2e:android": "node ../DemoCapacitor/e2e/run.js --app . --platform android",
    "e2e:ios": "node ../DemoCapacitor/e2e/run.js --app . --platform ios"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@ionic/angular": "^8.8.19",
    "@ionic/angular-toolkit": "^13.0.0",
    "capacitor-acoustic-connect-beta": "1.0.10",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.35",
    "@angular/cli": "^20.3.35",
    "@angular/compiler-cli": "^20.3.0",
    "typescript": "~5.9.2"
  },
  "description": "Angular 20 + Ionic 8 + Capacitor 8 sample for capacitor-acoustic-connect-beta"
}
