<?xml version="1.0" encoding="utf-8"?>
<!-- The example posts to a collector sink on the developer's machine over plain HTTP. Only those addresses may use
     cleartext; everything else must be HTTPS. Do not copy this into a production app. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
