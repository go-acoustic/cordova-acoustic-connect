{
  "name": "capacitor-acoustic-connect-beta",
  "version": "1.0.14",
  "description": "Capacitor plugin for Acoustic Connect (CDP + engagement).",
  "main": "dist/plugin.cjs.js",
  "bin": {
    "acoustic-connect": "cli/index.cjs"
  },
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "cli/",
    "dist/",
    "LICENSE",
    "docs/configuration.md",
    "docs/push.md",
    "docs/troubleshooting.md",
    "docs/migration-from-cordova.md",
    "ios/Sources",
    "ios/Tests",
    "Package.swift",
    "CapacitorAcousticConnectBeta.podspec"
  ],
  "author": "Acoustic",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/go-acoustic/cordova-acoustic-connect.git"
  },
  "bugs": {
    "url": "https://github.com/go-acoustic/cordova-acoustic-connect/issues"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "native"
  ],
  "scripts": {
    "verify": "npm run verify:ios && npm run verify:android && npm run verify:web",
    "verify:ios": "xcodebuild -scheme CapacitorAcousticConnectBeta -destination generic/platform=iOS",
    "verify:android": "cd android && ./gradlew clean build test && cd ..",
    "verify:web": "npm run build",
    "e2e:android": "node ../../applications/DemoCapacitor/e2e/run.js --platform android",
    "e2e:ios": "node ../../applications/DemoCapacitor/e2e/run.js --platform ios",
    "lint": "npm run eslint && npm run prettier -- --check && npm run swiftlint -- lint",
    "fmt": "npm run eslint -- --fix && npm run prettier -- --write && npm run swiftlint -- --fix --format",
    "eslint": "eslint . --ext ts",
    "prettier": "prettier \"**/*.{css,html,ts,js,java}\" --plugin=prettier-plugin-java",
    "swiftlint": "node-swiftlint",
    "docgen": "docgen --api AcousticConnectApi --output-readme README.md --output-json dist/docs.json",
    "build": "npm run clean && npm run docgen && tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "test:strict": "tsc --noEmit -p tsconfig.test.json"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.0.0",
    "@capacitor/docgen": "^0.3.1",
    "@capacitor/ios": "^8.0.0",
    "@ionic/eslint-config": "^0.4.0",
    "@ionic/prettier-config": "^4.0.0",
    "@ionic/swiftlint-config": "^2.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.6.4",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "prettier-plugin-java": "^2.7.7",
    "rimraf": "^6.1.0",
    "rollup": "^4.53.2",
    "swiftlint": "^2.0.0",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0"
  },
  "prettier": "@ionic/prettier-config",
  "swiftlint": "@ionic/swiftlint-config",
  "eslintConfig": {
    "extends": "@ionic/eslint-config/recommended"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  }
}
